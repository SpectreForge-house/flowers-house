# Supabase configuration
# Get these values from your Supabase project dashboard:
#   Settings > API > Project URL and anon/public key

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: base URL used in confirmation and password-reset emails for the web
# and desktop builds. Defaults to the current browser origin when omitted.
# The Android app uses the com.flowershouse.app:// custom scheme instead.
VITE_PUBLIC_APP_URL=http://localhost:5173
