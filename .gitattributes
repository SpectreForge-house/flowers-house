# Normalize line endings in the repository, keep Windows scripts usable.
* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.wav binary
*.mp3 binary
*.jar binary
*.jks binary
*.keystore binary
